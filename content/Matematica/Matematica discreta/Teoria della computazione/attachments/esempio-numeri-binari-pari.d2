direction: right

start: "" {
  shape: circle
  width: 1
  height: 1
  style.fill: black
}

sx: |latex q_x | {
  shape: circle
}

q0: |latex q_0 | {
  shape: circle
  style.double-border: true
}

q1: |latex q_1 | {
  shape: circle
}

start -> sx
sx -> q0: |latex 0 |
sx -> q1: |latex 1 |
q0 -> q0: |latex 0 |
q0 -> q1: |latex 1 |
q1 -> q0: |latex 0 |
q1 -> q1: |latex 1 |
