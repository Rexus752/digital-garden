direction: right

start: "" {
  shape: circle
  width: 1
  height: 1
  style.fill: black
}

s0: |latex s_0 | {
  shape: circle
}

s1: |latex s_1 | {
  shape: circle
  style.double-border: true
}

s2: |latex s_2 | {
  shape: circle
}

start -> s0
s0 -> s1: |latex \text{a} |
s0 -> s2: |latex \text{b} |
s1 -> s0: |latex \text{a} |
s1 -> s1: |latex \text{b} |
s2 -> s0: |latex \text{b} |
s2 -> s2: |latex \text{a} |
