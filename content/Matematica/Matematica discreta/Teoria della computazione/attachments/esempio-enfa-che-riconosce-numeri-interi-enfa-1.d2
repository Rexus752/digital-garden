direction: right

start: "" {
  shape: circle
  width: 1
  height: 1
  style.fill: black
}

q0: |latex q_0 | {
  shape: circle
}

q1: |latex q_1 | {
  shape: circle
}

q2: |latex q_2 | {
  shape: circle
  style.double-border: true
}

start -> q0
q0 -> q1: |latex +,-,\varepsilon |
q1 -> q2: |latex 0,1,2,\ldots,9 |
q2 -> q2: |latex 0,1,2,\ldots,9 |