direction: right

start: "" {
  shape: circle
  width: 1
  height: 1
  style.fill: black
}

lr1: |latex L(\mathcal{R}_1) | {
  shape: rectangle
  style.border-radius: 16

  q1: "" {
    shape: circle
  }

  qf1: "" {
    shape: circle
  }

  q1 -> qf1: |latex \ldots | {
    style.stroke-dash: 4
  }
}

lr2: |latex L(\mathcal{R}_2) | {
  shape: rectangle
  style.border-radius: 16

  q2: "" {
    shape: circle
  }

  qf2: "" {
    shape: circle
    style.double-border: true
  }

  q2 -> qf2: |latex \ldots | {
    style.stroke-dash: 4
  }
}

start -> lr1.q1
lr1.qf1 -> lr2.q2: |latex \varepsilon |
