direction: right

start: "" {
  shape: circle
  width: 1
  height: 1
  style.fill: black
}

q0: |latex \{q_0\} | {
  shape: oval
}

q0q1: |latex \{q_0, q_1\} | {
  shape: oval
}

q0q2: |latex \{q_0, q_2\} | {
  shape: oval
}

q0q3: |latex \{q_0, q_3\} | {
  shape: oval
  style.double-border: true
}

start -> q0
q0 -> q0q1: |latex \text{a} |
q0 -> q0: |latex \text{b} |
q0q1 -> q0q1: |latex \text{a} |
q0q1 -> q0q2: |latex \text{b} |
q0q2 -> q0q1: |latex \text{a} |
q0q2 -> q0q3: |latex \text{b} |
q0q3 -> q0q1: |latex \text{a} |
q0q3 -> q0: |latex \text{b} |
