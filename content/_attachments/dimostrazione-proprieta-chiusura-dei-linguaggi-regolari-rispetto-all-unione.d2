direction: right

start: "" {
  shape: circle
  width: 1
  height: 1
  style.fill: black
}

q0: |latex q_0 | {
  shape: circle
}

e1: |latex \mathcal{E}_1 | {
  shape: rectangle
  style.border-radius: 16

  q1: |latex q_1 | {
    shape: circle
  }

  qf1: |latex q_{F_1} | {
    shape: circle
  }

  q1 -> qf1: |latex \ldots | {
    style.stroke-dash: 4
  }
}

e2: |latex \mathcal{E}_2 | {
  shape: rectangle
  style.border-radius: 16

  q2: |latex q_2 | {
    shape: circle
  }

  qf2: |latex q_{F_2} | {
    shape: circle
  }

  q2 -> qf2: |latex \ldots | {
    style.stroke-dash: 4
  }
}

start -> q0
q0 -> e1.q1: |latex \varepsilon |
q0 -> e2.q2: |latex \varepsilon |
