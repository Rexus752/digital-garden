direction: right

start: "" {
  shape: circle
  width: 1
  height: 1
  style.fill: black
}

q0: |latex q_0 | {
  shape: circle
}

e1: |latex \mathcal{E}_1 | {
  shape: rectangle

  q1: |latex q_1 | {
    shape: circle
  }

  e1dots: |latex \cdots |

  qf1: |latex q_{F_1} | {
    shape: circle
  }

  q1 -> e1dots
  e1dots -> qf1
}

e2: |latex \mathcal{E}_2 | {
  shape: rectangle

  q2: |latex q_2 | {
    shape: circle
  }

  e2dots: |latex \cdots |

  qf2: |latex q_{F_2} | {
    shape: circle
  }

  q2 -> e2dots
  e2dots -> qf2
}

start -> q0
q0 -> e1.q1: |latex \varepsilon |
q0 -> e2.q2: |latex \varepsilon |
