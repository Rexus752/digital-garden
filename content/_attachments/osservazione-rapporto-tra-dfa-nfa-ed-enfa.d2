direction: right

DFA: |latex \text{DFA} | {
  shape: rectangle
  style.border-radius: 8
}

NFA: |latex \text{NFA} | {
  shape: rectangle
  style.border-radius: 8
}

eNFA: |latex \varepsilon\text{-NFA} | {
  shape: rectangle
  style.border-radius: 8
}

DFA -> NFA: caso particolare di
NFA -> eNFA: caso particolare di
NFA -> DFA: costruzione per sottoinsiemi
eNFA -> NFA: costruzione per sottoinsiemi
