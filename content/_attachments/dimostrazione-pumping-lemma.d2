direction: down

start: "" {
  shape: circle
  width: 1
  height: 1
  style.fill: black
}

q0: |latex q_0 | {
  shape: circle
}

q1: |latex q_1 | {
  shape: circle
}

q2: |latex q_2 | {
  shape: circle
}

qm1: |latex q_{m-1} | {
  shape: circle
}

qm: |latex q_{m} | {
  shape: circle
  style.double-border: true
}

start -> q0
q0 -> q1: |latex a_1 |
q1 -> q2: |latex a_2 |
q2 -> qm1: |latex a_3 \ldots a_{m-1} | {
  style.stroke-dash: 4
}
qm1 -> qm: |latex a_m |
